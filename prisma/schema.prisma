generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin-arm64", "linux-arm64-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthRole {
  ADMIN
  STATION
}

enum AppointmentStatus {
  CREATED
  WAITING
  ASSIGNED
  IN_SERVICE
  PAYMENT_PENDING
  COMPLETED
}

enum TurnStatus {
  ASSIGNED
  ACCEPTED
  SKIPPED
  FINISHED
}

enum AttendanceStatus {
  PRESENT
  CHECKED_OUT
  ABSENT
}

enum AttendanceClosedBy {
  STAFF
  ADMIN
  AUTO
}

enum Availability {
  AVAILABLE
  BUSY
}

enum PaymentMethod {
  CARD
  CASH
}

enum ActorType {
  ADMIN
  STATION
  STAFF
  SYSTEM
}

model Skill {
  id            String         @id @default(cuid())
  name          String         @unique
  serviceSkills ServiceSkill[]
  staff         StaffSkill[]
  createdAt     DateTime       @default(now()) @map("created_at")

  @@map("skills")
}

model Service {
  id                  String               @id @default(cuid())
  name                String
  iconKey             String               @default("sparkles") @map("icon_key")
  durationMin         Int                  @map("duration_min")
  price               Decimal              @db.Decimal(10, 2)
  requiredSkills      ServiceSkill[]
  appointments        Appointment[]
  appointmentServices AppointmentService[]
  isActive            Boolean              @default(true) @map("is_active")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("services")
}

model ServiceSkill {
  serviceId String  @map("service_id")
  skillId   String  @map("skill_id")
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@id([serviceId, skillId])
  @@index([skillId])
  @@map("service_skills")
}

model Staff {
  id                     String                       @id @default(cuid())
  name                   String
  initials               String
  pinHash                String                       @map("pin_hash")
  isActive               Boolean                      @default(true) @map("is_active")
  skills                 StaffSkill[]
  appointments           Appointment[]
  serviceAppointments    AppointmentService[]         @relation("appointment_service_primary_staff")
  assignedTurns          Turn[]                       @relation("assigned_turns")
  supportingAppointments AppointmentSupportingStaff[]
  attendance             Attendance[]
  serviceState           StaffServiceState?
  verifiedSessions       VerifiedStaffSession[]
  createdAt              DateTime                     @default(now()) @map("created_at")
  updatedAt              DateTime                     @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("staff")
}

model StaffSkill {
  staffId String @map("staff_id")
  skillId String @map("skill_id")
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([staffId, skillId])
  @@map("staff_skills")
}

model AuthUser {
  id                String                 @id @default(cuid())
  email             String                 @unique
  passwordHash      String                 @map("password_hash")
  role              AuthRole
  isActive          Boolean                @default(true) @map("is_active")
  confirmedPayments Payment[]              @relation("confirmed_payments")
  stationSessions   VerifiedStaffSession[] @relation("station_sessions")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  @@index([role, isActive])
  @@map("auth_users")
}

model Customer {
  id              String        @id @default(cuid())
  phone           String        @unique
  phoneNormalized String        @unique @map("phone_normalized")
  name            String
  appointments    Appointment[]
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([name])
  @@map("customers")
}

model Appointment {
  id                  String                       @id @default(cuid())
  code                String
  customerId          String                       @map("customer_id")
  serviceId           String                       @map("service_id")
  serviceNameSnapshot String                       @map("service_name_snapshot")
  durationMinSnapshot Int                          @map("duration_min_snapshot")
  status              AppointmentStatus
  primaryStaffId      String?                      @map("primary_staff_id")
  amount              Decimal                      @db.Decimal(10, 2)
  businessDate        DateTime                     @map("business_date") @db.Date
  createdAt           DateTime                     @default(now()) @map("created_at")
  completedAt         DateTime?                    @map("completed_at")
  customer            Customer                     @relation(fields: [customerId], references: [id])
  service             Service                      @relation(fields: [serviceId], references: [id])
  primaryStaff        Staff?                       @relation(fields: [primaryStaffId], references: [id])
  turns               Turn[]
  supportingStaff     AppointmentSupportingStaff[]
  payment             Payment?
  services            AppointmentService[]

  @@unique([businessDate, code])
  @@index([businessDate, status])
  @@index([customerId, createdAt])
  @@map("appointments")
}

model AppointmentService {
  id                  String            @id @default(cuid())
  appointmentId       String            @map("appointment_id")
  serviceId           String            @map("service_id")
  sequence            Int
  serviceNameSnapshot String            @map("service_name_snapshot")
  durationMinSnapshot Int               @map("duration_min_snapshot")
  amount              Decimal           @db.Decimal(10, 2)
  status              AppointmentStatus
  primaryStaffId      String?           @map("primary_staff_id")
  completedAt         DateTime?         @map("completed_at")
  appointment         Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service             Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  primaryStaff        Staff?            @relation("appointment_service_primary_staff", fields: [primaryStaffId], references: [id])
  turns               Turn[]
  paymentItems        PaymentItem[]

  @@unique([appointmentId, sequence])
  @@index([appointmentId, status, sequence])
  @@map("appointment_services")
}

model Turn {
  id                   String              @id @default(cuid())
  appointmentId        String              @map("appointment_id")
  appointmentServiceId String?             @map("appointment_service_id")
  assignedStaffId      String?             @map("assigned_staff_id")
  status               TurnStatus
  reason               String?
  createdAt            DateTime            @default(now()) @map("created_at")
  endedAt              DateTime?           @map("ended_at")
  appointment          Appointment         @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  appointmentService   AppointmentService? @relation(fields: [appointmentServiceId], references: [id], onDelete: Cascade)
  assignedStaff        Staff?              @relation("assigned_turns", fields: [assignedStaffId], references: [id])

  @@index([appointmentId, createdAt])
  @@index([appointmentServiceId, createdAt])
  @@index([assignedStaffId, status])
  @@map("turns")
}

model AppointmentSupportingStaff {
  appointmentId String      @map("appointment_id")
  staffId       String      @map("staff_id")
  addedAt       DateTime    @default(now()) @map("added_at")
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  staff         Staff       @relation(fields: [staffId], references: [id])

  @@id([appointmentId, staffId])
  @@map("appointment_supporting_staff")
}

model Attendance {
  id           String              @id @default(cuid())
  staffId      String              @map("staff_id")
  businessDate DateTime            @map("business_date") @db.Date
  checkInAt    DateTime?           @map("check_in_at")
  checkOutAt   DateTime?           @map("check_out_at")
  status       AttendanceStatus
  closedBy     AttendanceClosedBy? @map("closed_by")
  staff        Staff               @relation(fields: [staffId], references: [id])

  @@unique([staffId, businessDate])
  @@index([businessDate, status])
  @@map("attendance")
}

model StaffServiceState {
  staffId               String       @id @map("staff_id")
  lastServiceFinishedAt DateTime?    @map("last_service_finished_at")
  availability          Availability @default(AVAILABLE)
  lastAssignedAt        DateTime?    @map("last_assigned_at")
  staff                 Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("staff_service_state")
}

model Payment {
  id                  String        @id @default(cuid())
  appointmentId       String        @unique @map("appointment_id")
  amount              Decimal       @db.Decimal(10, 2)
  tip                 Decimal       @default(0) @db.Decimal(10, 2)
  method              PaymentMethod
  serviceNameSnapshot String        @map("service_name_snapshot")
  staffNameSnapshot   String?       @map("staff_name_snapshot")
  confirmedByAdminId  String?       @map("confirmed_by_admin_id")
  confirmedAt         DateTime?     @map("confirmed_at")
  appointment         Appointment   @relation(fields: [appointmentId], references: [id])
  confirmedByAdmin    AuthUser?     @relation("confirmed_payments", fields: [confirmedByAdminId], references: [id])
  items               PaymentItem[]

  @@index([confirmedAt, method])
  @@map("payments")
}

model PaymentItem {
  id                   String             @id @default(cuid())
  paymentId            String             @map("payment_id")
  appointmentServiceId String             @map("appointment_service_id")
  serviceNameSnapshot  String             @map("service_name_snapshot")
  staffNameSnapshot    String?            @map("staff_name_snapshot")
  amount               Decimal            @db.Decimal(10, 2)
  payment              Payment            @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  appointmentService   AppointmentService @relation(fields: [appointmentServiceId], references: [id], onDelete: Restrict)

  @@unique([paymentId, appointmentServiceId])
  @@index([appointmentServiceId])
  @@map("payment_items")
}

model VerifiedStaffSession {
  id            String   @id @default(cuid())
  staffId       String   @map("staff_id")
  stationUserId String   @map("station_user_id")
  startedAt     DateTime @default(now()) @map("started_at")
  expiresAt     DateTime @map("expires_at")
  staff         Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  stationUser   AuthUser @relation("station_sessions", fields: [stationUserId], references: [id])

  @@index([stationUserId, expiresAt])
  @@index([staffId, expiresAt])
  @@map("verified_staff_sessions")
}

model AuditEvent {
  id        String    @id @default(cuid())
  ts        DateTime  @default(now())
  actorType ActorType @map("actor_type")
  actorId   String?   @map("actor_id")
  action    String
  entity    String
  entityId  String?   @map("entity_id")
  metadata  Json?

  @@index([entity, entityId, ts])
  @@index([actorType, actorId, ts])
  @@map("audit_events")
}

model CommandReceipt {
  id        String   @id @default(cuid())
  scope     String
  key       String
  response  Json
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([scope, key])
  @@index([createdAt])
  @@map("command_receipts")
}

model ShopConfig {
  id                    Int      @id @default(1)
  timezone              String   @default("Asia/Ho_Chi_Minh")
  closingTime           String   @default("21:00") @map("closing_time")
  verifiedSessionTtlMin Int      @default(3) @map("verified_session_ttl_min")
  currency              String   @default("USD")
  roundRobinEnabled     Boolean  @default(true) @map("round_robin_enabled")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("shop_config")
}
