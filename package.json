{
  "name": "nail-shop-management",
  "version": "1.0.0",
  "private": true,
  "browserslist": [
    "iOS >= 12",
    "Safari >= 12",
    "last 2 versions"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:d1": "npm run build:vinext && node scripts/run-d1-e2e.mjs",
    "db:generate": "prisma generate",
    "db:generate:d1": "prisma generate --schema prisma/d1/schema.prisma",
    "db:generate:all": "npm run db:generate && npm run db:generate:d1",
    "predev": "npm run db:generate:all",
    "prebuild": "npm run db:generate:all",
    "pretypecheck": "npm run db:generate:all",
    "pretest": "npm run db:generate:all",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:d1:sql": "tsx scripts/seed-d1-bootstrap.ts",
    "benchmark:db": "tsx scripts/benchmark-db.ts",
    "load:profile": "tsx scripts/load-profile.ts",
    "load:http": "tsx scripts/http-load-profile.ts",
    "db:studio": "prisma studio",
    "format": "prettier --write .",
    "predev:vinext": "npm run db:generate:d1",
    "dev:vinext": "vite dev --port 3001",
    "prebuild:vinext": "npm run db:generate:d1",
    "build:vinext": "CLOUDFLARE_VITE_FORCE_BUILD_OUTPUT=true vite build && node scripts/prepare-vinext-cloudflare-output.mjs",
    "start:vinext": "vite preview",
    "deploy:vinext": "npm run build:vinext && wrangler deploy --config wrangler.production.jsonc"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-d1": "6.19.3",
    "@prisma/client": "^6.19.3",
    "hash-wasm": "^4.12.0",
    "lucide-react": "0.468.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.12.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "6.0.0",
    "@vitejs/plugin-rsc": "0.5.36",
    "@vitest/coverage-v8": "^2.1.9",
    "@vinext/cloudflare": "1.1.0",
    "argon2": "^0.45.1",
    "cf": "1.0.0-beta.14",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.4.0",
    "jsdom": "25.0.1",
    "prettier": "3.4.2",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "5.7.2",
    "vite": "8.3.0",
    "vitest": "^2.1.9",
    "vinext": "1.1.0"
  },
  "type": "module"
}
