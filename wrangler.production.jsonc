{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wellness",
  "main": ".cloudflare/output/v0/workers/default/bundle/index.js",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": ".cloudflare/output/v0/workers/default/assets",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wellness-salon",
      "database_id": "03e062f4-935f-4297-aa6a-68628ea66e8a",
      "migrations_dir": "prisma/d1/migrations"
    }
  ],
  "vars": {
    "SHOP_TIMEZONE": "Asia/Ho_Chi_Minh",
    "PRODUCTION_TIMEZONE_CONFIRMED": "true",
    "SCHEDULER_CRON": "*/15 * * * *"
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
