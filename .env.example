POSTGRES_DB="nailshop"
POSTGRES_USER="nailshop"
POSTGRES_PASSWORD="replace-with-a-long-random-database-password"
DATABASE_URL="postgresql://nailshop:replace-with-a-long-random-database-password@postgres:5432/nailshop?schema=public"
AUTH_SECRET="replace-with-a-long-random-auth-secret"
AUTH_COOKIE_SECURE="true"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="https://your-production-domain.example"
NODE_ENV="production"
# Bootstrap fallback; the owner-confirmed salon timezone is Asia/Ho_Chi_Minh.
# Keep the authoritative ShopConfig value aligned before enabling jobs.
SHOP_TIMEZONE="Asia/Ho_Chi_Minh"
CRON_SECRET="replace-with-a-random-scheduler-secret"
# Keep false until timezone/DST tests and the UTC cron conversion are approved.
# This gate is checked by the Worker scheduled handler.
PRODUCTION_TIMEZONE_CONFIRMED="false"
# Cloudflare uses one UTC quarter-hour trigger; the Worker reads the current
# ShopConfig timezone and closing time from D1 before running either job.
SCHEDULER_CRON="*/15 * * * *"
ADMIN_EMAIL="admin@your-domain.example"
ADMIN_PASSWORD="replace-with-a-strong-admin-password"
STATION_EMAIL="station@your-domain.example"
STATION_PASSWORD="replace-with-a-strong-station-password"
STAFF_DEFAULT_PIN="replace-with-four-digits"
