# Worker + local D1 runtime settings.
AUTH_SECRET="replace-with-a-long-random-auth-secret"
AUTH_COOKIE_SECURE="false"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://127.0.0.1:3001"
NODE_ENV="development"
# Local D1 bootstrap inputs; the authoritative ShopConfig value is stored in D1.
SHOP_TIMEZONE="Asia/Ho_Chi_Minh"
CRON_SECRET="replace-with-a-random-scheduler-secret"
PRODUCTION_TIMEZONE_CONFIRMED="false"
SCHEDULER_CRON="*/15 * * * *"
ADMIN_EMAIL="admin@your-domain.example"
ADMIN_PASSWORD="replace-with-a-strong-admin-password"
STATION_EMAIL="station@your-domain.example"
STATION_PASSWORD="replace-with-a-strong-station-password"
STAFF_DEFAULT_PIN="replace-with-four-digits"
